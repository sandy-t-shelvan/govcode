{
  "schema": "govcode.policy/v1",
  "classification": "SECRET//NOFORN",
  "repo_root": "/srv/git/work/radar-fw",
  "state_dir": "/var/lib/govcode/radar-fw",
  "target_branch": "main",
  "sensitive": true,
  "two_person_rule": true,
  "approvers": [
    "jdoe",
    "asmith"
  ],
  "proposers": [],
  "allow_non_interactive_approval": false,
  "max_turns": 40,
  "model": {
    "backend": "ollama",
    "endpoint": "http://127.0.0.1:11434",
    "lock": "/opt/govcode/models/models.lock.json",
    "id": "devstral-small-24b",
    "num_ctx": 32768,
    "max_tokens": 4096,
    "temperature": 0.15,
    "verify_digest": true,
    "denied_origins": [
      "CN"
    ]
  },
  "tests": {
    "command": "make test",
    "timeout_seconds": 900,
    "require_pass": true
  },
  "commands": {
    "allowlist": [
      "make",
      "cmake --build",
      "gcc",
      "g++",
      "cc",
      "gnatmake",
      "gprbuild",
      "cobc",
      "gfortran"
    ],
    "prompt_for_others": true
  },
  "sandbox": {
    "mode": "required",
    "extra_ro_paths": [
      "/opt/gnat"
    ],
    "env": []
  },
  "trust": {
    "enforce": "strict",
    "release_keys": [
      "/etc/govcode/trust/release.pub"
    ],
    "release_manifest": "/opt/govcode/manifest.json",
    "release_provenance": "/opt/govcode/provenance.intoto.jsonl",
    "model_keys": [
      "/etc/govcode/trust/models.pub"
    ],
    "keyring_dir": "/etc/govcode/keys",
    "user_ca": "/etc/govcode/trust/user-ca-bundle.pem"
  },
  "audit": {
    "require_append_only": true
  },
  "permissions": {
    "allow": [
      "run_command(make *)",
      "run_command(gprbuild *)",
      "edit_file(src/**)",
      "edit_file(test/**)"
    ],
    "ask": [
      "edit_file(Makefile)",
      "edit_file(**/*.gpr)",
      "edit_file(build/**)",
      "run_command(git *)"
    ],
    "deny": [
      "read_file(keys/**)",
      "read_file(**/*.pem)",
      "edit_file(**/*.pem)",
      "run_command(rm *)",
      "run_command(curl *)",
      "run_command(scp *)",
      "run_command(ssh *)"
    ]
  },
  "secrets": {
    "allow": []
  },
  "spillage_guard": true,
  "hooks": {
    "post_edit": [
      "/opt/govcode/hooks/cppcheck.sh"
    ],
    "pre_proposal": [
      "/opt/govcode/hooks/cppcheck.sh",
      "/opt/govcode/hooks/gnat-style.sh"
    ]
  },
  "site_instructions": "/etc/govcode/site-instructions.md",
  "require_plan_approval": true,
  "siem": {
    "syslog": true
  },
  "analysis": {
    "required": true,
    "analyzers": [
      {
        "name": "cppcheck",
        "extensions": [
          ".c",
          ".h"
        ],
        "command": "cppcheck --quiet --error-exitcode=1 --enable=warning,portability --inline-suppr --template={file}:{line}:{severity}:{id}:{message}",
        "fail_on": ":(error|warning):",
        "finding": ":(error|warning|style|portability|performance):"
      },
      {
        "name": "clang-tidy",
        "extensions": [
          ".cpp",
          ".cc",
          ".cxx",
          ".hpp",
          ".hh"
        ],
        "command": "clang-tidy --quiet --checks=-*,clang-analyzer-*,bugprone-*,cert-* --warnings-as-errors=clang-analyzer-*,cert-*",
        "fail_on": " error: ",
        "finding": " (warning|error): "
      },
      {
        "name": "gnat",
        "extensions": [
          ".adb",
          ".ads"
        ],
        "command": "gcc -c -gnatc -gnatwa -gnatwe -gnaty3abcefhiklmnprt",
        "fail_on": "(error|warning|\\(style\\))",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cobc",
        "extensions": [
          ".cbl",
          ".cob",
          ".cpy"
        ],
        "command": "cobc -fsyntax-only -Wall",
        "fail_on": "error:",
        "finding": "(error|warning):"
      }
    ],
    "unanalyzed_ok": [
      "docs/**",
      "**/*.md",
      "**/Makefile",
      "GOVCODE.md"
    ],
    "timeout_seconds": 900
  },
  "host": {
    "require_fips": true,
    "require_selinux": true
  },
  "require_hardware_approver": true
}
